state.tas5806audio {
	control.1 {
		iface MIXER
		name 'Master Playback Volume A'
		value.0 92
		value.1 92
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 98'
		}
	}
	control.2 {
		iface MIXER
		name 'Master Playback Volume B'
		value.0 92
		value.1 92
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 98'
		}
	}
	control.3 {
		iface MIXER
		name 'Mic Capture Volume'
		value.0 30
		value.1 30
		comment {
			access 'read write user'
			type INTEGER
			count 2
			range '0 - 50'
			tlv '0000000100000008fffffc1800000064'
			dbmin -1000
			dbmax 4000
			dbvalue.0 2000
			dbvalue.1 2000
		}
	}
}
